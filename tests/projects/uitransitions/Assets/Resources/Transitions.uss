.box { width: 100px; height: 50px; opacity: 1; background-color: rgb(0, 0, 0); margin-left: 0; translate: 0 0; scale: 1 1; rotate: 0deg; }
.box.changed { width: 300px; opacity: 0; background-color: rgb(255, 128, 0); margin-left: 40px; translate: 100px 20px; scale: 2 3; rotate: 90deg; }
.box.third { width: 200px; }

.box.uss { transition: width 1s linear 200ms, opacity 500ms linear; }
.box.longhands { transition-property: width, opacity; transition-duration: 1000ms, 500ms; transition-delay: -250ms, 100ms; transition-timing-function: linear; }
.box.percent { width: 50%; }

.box.colored { color: red; }

.box.units { translate: 20px 10px; }
