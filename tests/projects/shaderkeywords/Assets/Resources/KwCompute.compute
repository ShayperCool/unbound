// Compute keyword declarations: global, local, dynamic.
#pragma kernel CSMain
#pragma kernel CSOther
#pragma multi_compile _ CS_GLOBAL_A CS_GLOBAL_B
#pragma multi_compile_local _ CS_LOCAL
#pragma dynamic_branch CS_DYN
#pragma multi_compile _ LIGHTMAP_ON

RWTexture2D<float4> Result;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) { Result[id.xy] = 0; }

[numthreads(8, 8, 1)]
void CSOther(uint3 id : SV_DispatchThreadID) { Result[id.xy] = 1; }
