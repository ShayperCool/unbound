:root {
    --accent: #3A79BB;
    --muted: rgb(120, 120, 128);
    --gap: 6px;
}

.root {
    flex-grow: 1;
    background-color: #2B2D31;
    padding: 8px;
}

.header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: var(--accent);
    padding-bottom: 4px;
    margin-bottom: var(--gap);
}

.title {
    font-size: 22px;
    color: white;
    -unity-font-style: bold;
}

.muted {
    color: var(--muted);
}

.subtitle {
    font-size: 11px;
}

.body {
    flex-direction: row;
    flex-grow: 1;
}

.column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--gap);
}

#right {
    margin-right: 0;
}

.row {
    flex-direction: row;
    align-items: center;
}

Button.primary {
    background-color: var(--accent);
    color: white;
    border-radius: 6px;
    padding: 4px 12px;
}

Button.primary:hover {
    background-color: #4C8DD0;
}

Button.primary:active {
    background-color: #2A5F96;
}

.box {
    width: 48px;
    height: 36px;
    margin: 4px;
    background-color: #C05A5A;
}

.rounded {
    border-radius: 12px 4px 18px 0;
}

.borders {
    border-width: 2px 4px 6px 8px;
    border-top-color: #E0C040;
    border-right-color: #40C060;
    border-bottom-color: #4080E0;
    border-left-color: #C040C0;
    border-radius: 8px;
    background-color: #303030;
}

.image {
    background-image: url("project://database/Assets/UI/Checker.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0.5);
}

.picture {
    width: 40px;
    height: 40px;
    margin-left: 4px;
}

.wrapped {
    width: 200px;
    white-space: normal;
    color: #D0D0D0;
    margin-top: 4px;
    -unity-text-align: upper-center;
}

.scroll {
    height: 140px;
    border-width: 1px;
    border-color: #555;
    margin-bottom: var(--gap);
}

.scroll-item {
    height: 18px;
    color: #E8E8E8;
    padding-left: 4px;
}

.scroll-item.even {
    background-color: #33363B;
}

.list {
    height: 100px;
    border-width: 1px;
    border-color: #555;
}

Label {
    color: #DDDDDD;
}
