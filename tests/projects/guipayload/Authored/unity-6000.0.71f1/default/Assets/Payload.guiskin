  m_Settings:
    m_DoubleClickSelectsWord: 1
    m_TripleClickSelectsLine: 1
    m_CursorColor: {r: 1, g: 1, b: 1, a: 1}
    m_CursorFlashSpeed: -1
    m_SelectionColor: {r: 0.5, g: 0.5, b: 1, a: 1}
