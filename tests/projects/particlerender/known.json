  ]
 },
 "mesh-bake-layout": {
  "reason": "Mesh render mode bakes of a non-uniformly scaled emitter (bake/mesh/*): the Editor scales a mesh particle's vertices by the emitter after turning them (its per-particle transform record matches Unbound's), Unbound before; and the Editor fills the indices texture from the mesh's 16-bit index buffer read as 32-bit values. Only this emitter was measured with a non-uniform scale.",
  "keys": [
   "bake/mesh/indices",
   "bake/mesh/perparticle/indices",
   "bake/mesh/vertices"
  ]
 },
