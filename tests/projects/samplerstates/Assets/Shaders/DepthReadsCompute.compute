// A kernel reading all four channels of both texels of a depth target as floats.
#pragma kernel Channels

Texture2D<float4> _Depth;
RWStructuredBuffer<float4> _Out;

[numthreads(1, 1, 1)]
void Channels(uint3 id : SV_DispatchThreadID)
{
    _Out[0] = _Depth.Load(int3(0, 0, 0));
    _Out[1] = _Depth.Load(int3(1, 0, 0));
}
