<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of UnityEngine.CoreModule's managed behaviour (math types and friends). -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UnboundNativeDir Condition="'$(UnboundNativeDir)' == '' and '$(CARGO_TARGET_DIR)' != ''">$([System.IO.Path]::GetFullPath('$(CARGO_TARGET_DIR)', '$(MSBuildStartupDirectory)'))/managed</UnboundNativeDir>
    <UnboundNativeDir Condition="'$(UnboundNativeDir)' == ''">$(MSBuildProjectDirectory)/../../target/managed</UnboundNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityEngine/UnityEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tests/projects/appfacts/Assets/Scripts/AppFactsUrlRecording.cs" Link="AppFactsUrlRecording.cs" />
    <None Include="../../tests/projects/spriteassets/Authored/unity-6000.0.71f1/sprites/Assets/Resources/*.asset" Link="SpriteFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native libraries the engine calls, as `cargo build` puts them next to it. -->
  <ItemGroup>
    <None Include="$(UnboundNativeDir)/*unbound_physx.*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Unbound.ReaderFields/Unbound.ReaderFields.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
