<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of UnityEngine.CoreModule's managed behaviour (math types and friends). -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- An explicit directory of the native libraries: UnboundNativeDir, else CARGO_TARGET_DIR's. -->
    <UnboundNativeDir Condition="'$(UnboundNativeDir)' == '' and '$(CARGO_TARGET_DIR)' != ''">$([System.IO.Path]::GetFullPath('$(CARGO_TARGET_DIR)', '$(MSBuildStartupDirectory)'))/managed</UnboundNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityEngine/UnityEngine.csproj" />
    <!-- The host's load-time rewrites of game assemblies (WideFloatsTests). -->
    <ProjectReference Include="../Unbound.Host/Unbound.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tests/projects/appfacts/Assets/Scripts/AppFactsUrlRecording.cs" Link="AppFactsUrlRecording.cs" />
    <None Include="../../tests/projects/spriteassets/Authored/unity-6000.0.71f1/sprites/Assets/Resources/*.asset" Link="SpriteFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/projects/spriteassets/Authored/unity-6000.0.71f1/sprites/Assets/Resources/Layouts/*.asset" Link="SpriteFixtures/Layouts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native library the engine calls, from the explicit directory; without one, the newer of
       the copies in the checkout's private target that tools/build.py selects and in a plain cargo
       build's ../../target (either may be left behind by the other kind of build). Without it the
       physics, cloth, vehicle and tessellation tests cannot run: stop with the reason instead of
       failing them. Copied on every build: the chosen copy may be older than the one last copied. -->
  <PropertyGroup>
    <UnboundNativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libunbound_physx.dylib</UnboundNativeFile>
    <UnboundNativeFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">libunbound_physx.so</UnboundNativeFile>
    <UnboundNativeFile Condition="'$(UnboundNativeFile)' == ''">unbound_physx.dll</UnboundNativeFile>
  </PropertyGroup>
  <Target Name="UnboundLocateNativeLibraries" BeforeTargets="AssignTargetPaths">
    <Exec Condition="'$(UnboundNativeDir)' == ''" Command="python3 tools/build.py --cache none --print-env"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.." ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="UnboundBuildEnvironment" />
    </Exec>
    <PropertyGroup Condition="'$(UnboundNativeDir)' != ''">
      <UnboundNativeLibrary Condition="Exists('$(UnboundNativeDir)/$(UnboundNativeFile)')">$(UnboundNativeDir)/$(UnboundNativeFile)</UnboundNativeLibrary>
      <UnboundSearched>$(UnboundNativeDir)</UnboundSearched>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UnboundNativeDir)' == ''">
      <UnboundBuildTarget>$([System.Text.RegularExpressions.Regex]::Match('$(UnboundBuildEnvironment)', '"CARGO_TARGET_DIR": "([^"]+)"').Groups[1].Value)</UnboundBuildTarget>
      <UnboundPrivateLibrary>$(UnboundBuildTarget)/managed/$(UnboundNativeFile)</UnboundPrivateLibrary>
      <UnboundPlainLibrary>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../target/managed/$(UnboundNativeFile)'))</UnboundPlainLibrary>
      <UnboundSearched>the private target of tools/build.py ($(UnboundBuildTarget)/managed) or $([System.IO.Path]::GetDirectoryName('$(UnboundPlainLibrary)'))</UnboundSearched>
      <UnboundNativeLibrary Condition="'$(UnboundBuildTarget)' != '' and Exists('$(UnboundPrivateLibrary)')">$(UnboundPrivateLibrary)</UnboundNativeLibrary>
      <UnboundNativeLibrary Condition="Exists('$(UnboundPlainLibrary)') and ('$(UnboundNativeLibrary)' == '' or
          $([System.IO.File]::GetLastWriteTime('$(UnboundPlainLibrary)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(UnboundNativeLibrary)').Ticks))">$(UnboundPlainLibrary)</UnboundNativeLibrary>
    </PropertyGroup>
    <Error Condition="'$(UnboundNativeLibrary)' == ''"
           Text="UnityEngine.Tests needs the native $(UnboundNativeFile), not found in $(UnboundSearched): build it with `python3 tools/build.py -- build --release --locked -p unbound`, or name its target with CARGO_TARGET_DIR or -p:UnboundNativeDir=&lt;target&gt;/managed." />
    <ItemGroup>
      <None Include="$(UnboundNativeLibrary)" CopyToOutputDirectory="Always" Link="$(UnboundNativeFile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Unbound.ReaderFields/Unbound.ReaderFields.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
