<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Unbound.ApiTools/Unbound.ApiTools.csproj" />
    <ProjectReference Include="../Unbound.Compiler/Unbound.Compiler.csproj" />
    <ProjectReference Include="../UnityEngine/UnityEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET's System.dll, System.Configuration.dll and System.Security.dll facades forward the
         .NET Framework types game code uses to these packages, which the shared framework lacks. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
