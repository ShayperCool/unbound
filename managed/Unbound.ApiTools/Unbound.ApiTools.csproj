<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tools that work on Unity's API surface as metadata: the per-release module facades, the API
       gap report (System.Reflection.Metadata) and the compatibility stub generator (Roslyn's symbol
       model, the same compiler package Unbound.Compiler uses). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
</Project>
