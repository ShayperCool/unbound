<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unbound's implementation of the Unity engine API. It is named after Unity's core module so that
       game code and plugins bind to it; the other modules are facades that forward to it. -->
  <PropertyGroup>
    <AssemblyName>UnityEngine.CoreModule</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);UNITY_ASSERTIONS;ENABLE_UNITY_COLLECTIONS_CHECKS;ENABLE_PROFILER</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0108;CS0114;CS1591;CS0618</NoWarn>
    <!-- The release family whose compatibility stubs (Generated/<family>/, `unbound gen-stubs`) are
         compiled in. UnboundNoStubs=true builds the hand-written implementation alone, which is what
         the stub generator compares Unity's API against. -->
    <UnboundStubFamily Condition="'$(UnboundStubFamily)' == ''">6000.0</UnboundStubFamily>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated/**" />
    <Compile Include="Generated/$(UnboundStubFamily)/**/*.cs" Condition="'$(UnboundNoStubs)' != 'true'" />
    <!-- Settings classes' type trees, by release family (tests/projects/settings/schema.py). -->
    <EmbeddedResource Include="Editor/Data/*.json" LogicalName="Unbound.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
