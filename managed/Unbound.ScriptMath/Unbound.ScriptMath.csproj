<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine's sources of the UnityEngine math structs Unity implements in C#, built without IL
       optimization, so every local they declare is a store: in the Editor each such local rounds
       (tests/projects/floatrounding). Never loaded: Unbound.Host embeds it and copies its method
       bodies into game assemblies, where they evaluate float arithmetic as the Editor's Mono does
       (WideFloats.EngineMath.cs). UNBOUND_SCRIPT_MATH leaves out the overloads that take engine
       classes (their math types are the engine's). -->
  <PropertyGroup>
    <Optimize>false</Optimize>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);UNITY_ASSERTIONS;ENABLE_UNITY_COLLECTIONS_CHECKS;ENABLE_PROFILER;UNBOUND_SCRIPT_MATH</DefineConstants>
    <!-- CS0436: these types are also the engine's; the sources' own win. -->
    <NoWarn>$(NoWarn);CS0436;CS0649;CS0169;CS0414;CS0108;CS0114;CS1591;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UnityEngine/Math/Mathf.cs;../UnityEngine/Math/Vector2.cs;../UnityEngine/Math/Vector3.cs;../UnityEngine/Math/Vector4.cs;../UnityEngine/Math/Vector2Int.cs;../UnityEngine/Math/Vector3Int.cs;../UnityEngine/Math/Quaternion.cs;../UnityEngine/Math/QuaternionMath.cs;../UnityEngine/Math/Matrix4x4.cs;../UnityEngine/Math/Color.cs;../UnityEngine/Math/Color32.cs;../UnityEngine/Math/Bounds.cs;../UnityEngine/Math/BoundsInt.cs;../UnityEngine/Math/Rect.cs;../UnityEngine/Math/RectInt.cs;../UnityEngine/Math/Plane.cs;../UnityEngine/Math/Ray.cs;../UnityEngine/Math/Pose.cs;../UnityEngine/Math/GeometryUtility.cs;../UnityEngine/Math/MathFormat.cs" />
    <ProjectReference Include="../UnityEngine/UnityEngine.csproj" />
  </ItemGroup>
</Project>
